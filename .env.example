# ==============================================================================
# RazorGrow AI — Environment Configuration & API Secrets Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# DO NOT commit your actual .env file to Git!

# Server Port
PORT=5000

# ------------------------------------------------------------------------------
# 1. Razorpay API Keys (Test Mode)
# ------------------------------------------------------------------------------
# Get your Test Key ID and Secret from Razorpay Dashboard:
# https://dashboard.razorpay.com/app/keys
# Make sure you are in "Test Mode" (key starts with rzp_test_)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Optional: Razorpay Webhook Secret (from Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 2. Google Gemini API Key
# ------------------------------------------------------------------------------
# Get your Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
